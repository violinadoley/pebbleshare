# ============================================
# Sui Blockchain Configuration
# ============================================
# Sui RPC endpoint for blockchain interactions
# Testnet: https://fullnode.testnet.sui.io:443
# Mainnet: https://fullnode.mainnet.sui.io:443
NEXT_PUBLIC_SUI_RPC_URL=https://fullnode.testnet.sui.io:443

# ============================================
# Seal Access Policy Configuration
# ============================================
# Package ID of your deployed Move contract for access policy
# Update this after deploying your payment_policy Move contract
# Example: 0x1234567890abcdef1234567890abcdef12345678
NEXT_PUBLIC_SEAL_PACKAGE_ID=0x0

# ============================================
# Backend API Configuration (if needed)
# ============================================
# URL of your x402 payment server
# Example: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001