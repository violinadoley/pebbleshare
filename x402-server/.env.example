# Server
PORT=3001
HOST=0.0.0.0

# Payment (Sui)
SUI_RPC_URL=https://fullnode.devnet.sui.io:443
PAYMENT_RECEIVER_ADDRESS=0xYOUR_SUI_ADDRESS
PAYMENT_CURRENCY=0x2::sui::SUI
MIN_PAYMENT_AMOUNT_RAW=1000000000
# Number of checkpoints to wait for transaction finality (recommended: 2-3)
SUI_FINALITY_CHECKPOINTS=2

# Walrus (replace with actual Walrus REST/SDK credentials)
WALRUS_API_URL=https://walrus.example/api
WALRUS_API_KEY=changeme

# Seal (replace with real Seal API endpoint or Sui/Move contract details)
SEAL_API_URL=https://seal.example/api
SEAL_API_KEY=changeme

# Local persistence (file for lowdb)
DB_FILE=./data/db.json

# Misc
NODE_ENV=development
